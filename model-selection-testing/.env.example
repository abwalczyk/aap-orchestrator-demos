# AO instance connection
AO_BASE_URL=http://your-ao-instance:8080
AO_USERNAME=your_username
AO_PASSWORD=your_password

# MLflow tracking
MLFLOW_TRACKING_URI=http://your-mlflow-instance:5001

# LLM judge endpoint (OpenAI-compatible, used for scoring)
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://your-llm-endpoint/v1

# Frontier model API keys (needed for LLM judges with real Anthropic/OpenAI)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
